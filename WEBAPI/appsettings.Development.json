{
  "MailSettings": {
    "Host": "localhost",
    "Port": 2525,
    "Security": "None",
    "SenderName": "RMS",
    "SenderEmail": "no-reply@rms.local",
    "UserName": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "ConnectionStrings": {
    "RmsDB": "Data Source=localhost;Database=RmsDB;Integrated Security=True;Trust Server Certificate=True;MultipleActiveResultSets=False;Connect Timeout=30;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/rms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "RMS.API"
    }
  },
  "AllowedHost": "*",
  "MaintenanceMode": false,
  "App": {
    "FrontendUrl": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "https://localhost:7001",
    "Audience": "rms-api",
    "ExpirateInMinutes": 60
  },
  "Seed": {
    "DefaultPassword": "Password123!",
    "ResetToCheckpointOnStartup": false,
    "IncludeSampleBatch": false
  }
}
