{
  "MailSettings": {
    "Host": "localhost",
    "Port": 2525,
    "Security": "None",
    "SenderName": "Rekrutin",
    "SenderEmail": "no-reply@rms.local",
    "UserName": "",
    "Password": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "ConnectionStrings": {
    "RmsDb": "Server=DESKTOP-SA037Q3\\SQLEXPRESS;Database=RmsDB;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=False;Max Pool Size=100;Connection Timeout=30;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/rms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "RMS.API"
    }
  },
  "AllowedHost": "*",
  "MaintenanceMode": false,
  "App": {
    "FrontendUrl": "http://localhost:5173",
    "CandidatePortalUrl": "http://localhost:5175"
  },
  "Jwt": {
    "Issuer": "https://localhost:7001",
    "Audience": "rms-api",
    "ExpirateInMinutes": 15
  },
  "Seed": {
    "DefaultPassword": "Password123!",
    "ResetToCheckpointOnStartup": true,
    "IncludeSampleBatch": false,
    "Performance": {
      "Enabled": false,
      "ResetBeforeSeed": true,
      "ClearOnCheckpointReset": true,
      "UseSqlBulkCopy": true,
      "BatchSize": 1000,
      "Interviewers": 30,
      "Batches": 14,
      "Candidates": 3000,
      "ApplicationsPerCandidate": 3,
      "EmailLogs": 10000,
      "RescheduleRequests": 500,
      "InterviewSessionRatio": 0.35,
      "CandidateAnswerRatio": 1.0,
      "RandomSeed": 20261117
    }
  }
}
